 "tokenColors": [
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#7D6E63",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "keyword",
    "storage.type",
    "storage.modifier",
    "keyword.control"
   ],
   "settings": {
    "foreground": "#E8895A"
   }
  },
  {
   "scope": [
    "keyword.operator",
    "punctuation"
   ],
   "settings": {
    "foreground": "#BFAE9F"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted"
   ],
   "settings": {
    "foreground": "#B5C58A"
   }
  },
  {
   "scope": [
    "constant.character.escape"
   ],
   "settings": {
    "foreground": "#E6C07B"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.other"
   ],
   "settings": {
    "foreground": "#E3A86B"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call"
   ],
   "settings": {
    "foreground": "#F2C27E"
   }
  },
  {
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.class",
    "support.type",
    "entity.other.inherited-class"
   ],
   "settings": {
    "foreground": "#E9B97A"
   }
  },
  {
   "scope": [
    "variable",
    "meta.definition.variable"
   ],
   "settings": {
    "foreground": "#E9DED4"
   }
  },
  {
   "scope": [
    "variable.parameter"
   ],
   "settings": {
    "foreground": "#E3C7AE",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "variable.other.property",
    "support.variable.property",
    "meta.object-literal.key"
   ],
   "settings": {
    "foreground": "#D8BFA8"
   }
  },
  {
   "scope": [
    "entity.name.tag"
   ],
   "settings": {
    "foreground": "#E8895A"
   }
  },
  {
   "scope": [
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#E6C07B",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "markup.heading",
    "entity.name.section"
   ],
   "settings": {
    "foreground": "#F2A071",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.bold"
   ],
   "settings": {
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.italic"
   ],
   "settings": {
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "markup.inline.raw",
    "markup.fenced_code"
   ],
   "settings": {
    "foreground": "#F2B98E"
   }
  },
  {
   "scope": [
    "markup.underline.link"
   ],
   "settings": {
    "foreground": "#EFA072"
   }
  },
  {
   "scope": [
    "meta.decorator",
    "entity.name.function.decorator",
    "punctuation.decorator"
   ],
   "settings": {
    "foreground": "#D69AC2"
   }
  },
  {
   "scope": [
    "invalid"
   ],
   "settings": {
    "foreground": "#F07A6A"
   }
  }
 ],
 "semanticTokenColors": {
  "parameter": {
   "foreground": "#E3C7AE",
   "italic": true
  },
  "property": "#D8BFA8",
  "enumMember": "#E3A86B",
  "type": "#E9B97A",
  "class": "#E9B97A",
  "function": "#F2C27E",
  "method": "#F2C27E"
 }
}